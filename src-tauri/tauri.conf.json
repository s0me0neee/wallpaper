{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "wall",
	"version": "1.0.0",
	"identifier": "com.maot27.wallpaper",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "wallpaper",
				"width": 920,
				"height": 650,
				"decorations": false,
				"transparent": true,
				"alwaysOnTop": true,
				"resizable": true,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"cli": {
			"description": "Set or browse wallpapers",
			"args": [
				{
					"name": "image",
					"description": "Path to image to set as wallpaper",
					"index": 1,
					"takesValue": true,
					"required": false
				},
				{
					"name": "verbose",
					"short": "v",
					"description": "Increase log verbosity (-v debug, -vv trace)",
					"multipleOccurrences": true
				},
				{
					"name": "quiet",
					"short": "q",
					"description": "Suppress all output"
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
